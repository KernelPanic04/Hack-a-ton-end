# Demo-only WebSocket handshake token. Use the same value as
# VITE_DEMO_TOKEN in the frontend; never use a production secret here.
DEMO_TOKEN=replace-with-a-shared-demo-token

# Host ports. Container ports remain PostgreSQL 5432 and FastAPI 8000.
BACKEND_PORT=8000
POSTGRES_PORT=5433
PORT=8000

# Comma-separated frontend origins accepted by FastAPI.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Required for Studio (prompt-to-UI, the live frontend product) to generate
# anything: with no key, /studio/generate always returns an "unavailable"
# placeholder layout — there is no deterministic fallback for a free-text
# prompt. Also powers the legacy runtime's optional progressive UISpec
# upgrade below, whose deterministic composer stays the complete fallback
# path with no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Studio kill switch and per-attempt provider timeout (it retries up to 5
# times). Raise the timeout if you ask for large layouts (e.g. a table with
# hundreds of rows) and see requests time out before completing.
STUDIO_GENERATION_ENABLED=true
STUDIO_GENERATION_TIMEOUT_SECONDS=25

# Everything below is legacy runtime only (workflows/runs/WebSocket) — none
# of it is used by Studio, and the current frontend has no route to reach it.
LLM_UPGRADE_ENABLED=true

# Optional LLM execution for runtime-defined workflow steps. It uses the same
# key/model, has a five-second timeout and falls back to deterministic output.
GENERIC_STEP_LLM_ENABLED=true

# Optional Ari chat assistant. It uses the same server-side key and falls back
# to a deterministic explanatory reply if disabled or the provider fails.
ASSISTANT_ENABLED=true

# Detailed SQLAlchemy statements stay off in normal demos and Railway logs.
SQL_ECHO=false

# Local uvicorn already defaults to PostgreSQL on localhost:5433. Override only
# when running against another database.
# DATABASE_URL=postgresql+asyncpg://hack_user:hack_password@localhost:5433/hackathon_db
