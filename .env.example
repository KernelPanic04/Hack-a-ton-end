# Demo-only WebSocket handshake token. Use the same value as
# VITE_DEMO_TOKEN in the frontend; never use a production secret here.
DEMO_TOKEN=replace-with-a-shared-demo-token

# Host ports. Container ports remain PostgreSQL 5432 and FastAPI 8000.
BACKEND_PORT=8000
POSTGRES_PORT=5433
PORT=8000

# Comma-separated frontend origins accepted by FastAPI.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional progressive UISpec upgrade. With no key (or when disabled), the
# deterministic composer remains the complete runtime path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_UPGRADE_ENABLED=true

# Local uvicorn already defaults to PostgreSQL on localhost:5433. Override only
# when running against another database.
# DATABASE_URL=postgresql+asyncpg://hack_user:hack_password@localhost:5433/hackathon_db
