# Demo-only WebSocket handshake token. Use the same value as
# VITE_DEMO_TOKEN in the frontend; never use a production secret here.
DEMO_TOKEN=replace-with-a-shared-demo-token

DATABASE_URL=postgresql+asyncpg://hack_user:hack_password@postgres:5432/hackathon_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
AUTH_USER_MODE=users
PORT=8000
BACKEND_PORT=8000
POSTGRES_PORT=5433
